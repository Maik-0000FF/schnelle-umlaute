post_install() {
    echo ""
    echo "==> Schnelle Umlaute installed!"
    echo ""
    echo "  1. Ensure fcitx5 environment variables are set:"
    echo "     GTK_IM_MODULE=fcitx  QT_IM_MODULE=fcitx  XMODIFIERS=@im=fcitx"
    echo ""
    echo "  2. Log out and log in for changes to take effect"
    echo ""
    echo "  3. Add input method:"
    echo "     fcitx5-config-qt -> Input Method -> Add -> 'Schnelle Umlaute'"
    echo ""
    echo "  4. Switch with Ctrl+Space, then: hold 'a' + Space -> ä"
    echo ""
}

post_upgrade() {
    echo ""
    echo "==> Schnelle Umlaute upgraded to $1"
    echo "    Restart fcitx5 to activate the new version."
    echo ""
}
