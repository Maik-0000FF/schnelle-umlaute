[Delay]
Name=Delay
Description=Delay Settings

[Delay/Lowercase]
Type=Integer
DefaultValue=400
Description=Lowercase (ms)
IntMin=50
IntMax=2000
IntStep=25

[Delay/Uppercase]
Type=Integer
DefaultValue=700
Description=Uppercase (ms)
IntMin=50
IntMax=2000
IntStep=25

[Leader]
Name=Leader Keys
Description=Leader Keys

[Leader/Space]
Type=Boolean
DefaultValue=True
Description=Space

[Leader/Left]
Type=Boolean
DefaultValue=False
Description=Left Arrow

[Leader/Right]
Type=Boolean
DefaultValue=False
Description=Right Arrow

[Leader/Up]
Type=Boolean
DefaultValue=False
Description=Up Arrow

[Leader/Down]
Type=Boolean
DefaultValue=False
Description=Down Arrow

[Leader/Alt]
Type=Boolean
DefaultValue=False
Description=Alt/AltGr

[Leader/Custom]
Name=Custom Leader Keys
Description=Custom Leader Keys

[Leader/Custom/CustomKeyEnabled]
Type=Boolean
DefaultValue=False
Description=Custom Leader 1

[Leader/Custom/CustomKey]
Type=String
DefaultValue=
Description=  ↳ Key
Placeholder=e.g. ; or #
Compact=True
Tooltip=Single character. Must not be a mapped input key.

[Leader/Custom/CustomKey2Enabled]
Type=Boolean
DefaultValue=False
Description=Custom Leader 2 (hand-split)

[Leader/Custom/CustomKey2]
Type=String
DefaultValue=
Description=  ↳ Key
Placeholder=e.g. j or f
Compact=True
Tooltip=Single character on the opposite keyboard half of Leader 1. Must not be a mapped input key.

[Mappings]
Name=Mappings
Description=Mappings

[Mappings/Editor]
Type=External
DefaultValue=
Description=Mapping Editor
External=fcitx://config/addon/schnelle-umlaute/mappings.txt

[AppFilter]
Name=App Filter
Description=App Filter

[AppFilter/Mode]
Type=Enum
DefaultValue=Disabled
Description=Mode
EnumCount=3
Enum0=Disabled
Enum1=Blacklist
Enum2=Whitelist

[AppFilter/Blacklist]
Type=List
ListType=String
DefaultValue=
Description=Blacklist
Tooltip=Case-sensitive substring match against the program identifier fcitx5 reports. Some apps report their GUI library instead of their name (e.g. Kitty → GLFW_Application).

[AppFilter/Whitelist]
Type=List
ListType=String
DefaultValue=
Description=Whitelist
Tooltip=Case-sensitive substring match against the program identifier fcitx5 reports. Some apps report their GUI library instead of their name (e.g. Kitty → GLFW_Application).

[Overlay]
Name=Overlay
Description=Cycle overlay

[Overlay/Enabled]
Type=Boolean
DefaultValue=False
Description=Show overlay while cycling

[Overlay/Position]
Type=Enum
DefaultValue=TopCenter
Description=Position on screen
EnumCount=9
Enum0=TopLeft
Enum1=TopCenter
Enum2=TopRight
Enum3=CenterLeft
Enum4=Center
Enum5=CenterRight
Enum6=BottomLeft
Enum7=BottomCenter
Enum8=BottomRight
