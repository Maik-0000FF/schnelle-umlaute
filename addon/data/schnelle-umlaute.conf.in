DefaultValue=400
Description=Lowercase (ms)
IntMin=50
IntMax=2000
IntStep=25

[Delay/Uppercase]
Type=Integer
DefaultValue=700
Description=Uppercase (ms)
IntMin=50
IntMax=2000
IntStep=25

[Leader]
Name=Leader Keys
Description=Leader Keys

[Leader/Space]
Type=Boolean
DefaultValue=True
Description=Space

[Leader/Left]
Type=Boolean
DefaultValue=False
Description=Left Arrow

[Leader/Right]
Type=Boolean
DefaultValue=False
Description=Right Arrow

[Leader/Up]
Type=Boolean
DefaultValue=False
Description=Up Arrow

[Leader/Down]
Type=Boolean
DefaultValue=False
Description=Down Arrow

[Leader/Alt]
Type=Boolean
DefaultValue=False
Description=⚠ experimental – Alt/AltGr

[Leader/CustomKeyEnabled]
Type=Boolean
DefaultValue=False
Description=⚠ Custom Leader 1

[Leader/CustomKey]
Type=String
DefaultValue=
Description=  ↳ Key (e.g. ; or #)

[Leader/CustomKey2Enabled]
Type=Boolean
DefaultValue=False
Description=⚠ Custom Leader 2 (hand-split)

[Leader/CustomKey2]
Type=String
DefaultValue=
Description=  ↳ Key (e.g. j or f)

