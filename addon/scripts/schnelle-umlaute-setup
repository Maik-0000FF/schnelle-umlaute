#!/usr/bin/env bash
# schnelle-umlaute-setup — One-time per-user setup for fcitx5 environment
# variables and autostart. Safe to re-run; preserves existing config when
# already correct, prompts before overwriting unrelated config.
#
# This script intentionally does NOT touch system files — it only writes
# to $HOME. Run as your normal user (not root, not sudo).

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

if [ "$EUID" -eq 0 ]; then
    echo -e "${RED}Error: do not run as root.${NC} Run as your normal user." >&2
    echo "  schnelle-umlaute-setup" >&2
    exit 1
fi

echo -e "${BLUE}=== Schnelle Umlaute — User Setup ===${NC}"
echo

# Session/desktop, needed both for the environment payload (KDE Plasma Wayland
# drops the redundant GTK/QT modules) and for the autostart choice below. The
# canonical spec for the reduced-vs-full decision is addon/src/session_env.h;
# this mirrors it because the AUR helper ships without the source tree.
SESSION="${XDG_SESSION_TYPE:-unknown}"
DESKTOP="${XDG_CURRENT_DESKTOP:-unknown}"

# True on KDE Plasma Wayland. Matches the desktop with a case-insensitive
# substring test to mirror containsCI() in addon/src/session_env.h, so a
# colon-list or differently-cased XDG_CURRENT_DESKTOP (e.g. "KDE:plasma") is
# still recognised as KDE, exactly like the canonical C++ decision.
is_kde_wayland() {
    [ "$SESSION" = "wayland" ] || return 1
    case "$DESKTOP" in *[Kk][Dd][Ee]*) return 0 ;; *) return 1 ;; esac
}

# True when GTK_IM_MODULE/QT_IM_MODULE should be dropped: KDE Plasma Wayland
# only (KWin serves the native text-input protocol; XMODIFIERS still covers
# XWayland). KDE X11 and everything else keep the full set.
reduced_env() { is_kde_wayland; }

# --- 1. Environment variables ---------------------------------------------
ENV_FILE="$HOME/.config/environment.d/fcitx5.conf"
mkdir -p "$(dirname "$ENV_FILE")"

write_env_file() {
    if reduced_env; then
        cat > "$ENV_FILE" <<'EOF'
XMODIFIERS=@im=fcitx
GLFW_IM_MODULE=ibus
EOF
    else
        cat > "$ENV_FILE" <<'EOF'
GTK_IM_MODULE=fcitx
QT_IM_MODULE=fcitx
XMODIFIERS=@im=fcitx
GLFW_IM_MODULE=ibus
EOF
    fi
}

# "Already configured" == the file holds what this desktop needs: on KDE Plasma
# Wayland just XMODIFIERS (a legacy full file also passes); otherwise all three
# canonical lines.
env_already_configured() {
    [ -f "$ENV_FILE" ] || return 1
    grep -q "^XMODIFIERS=@im=fcitx$" "$ENV_FILE" || return 1
    reduced_env && return 0
    grep -q "^GTK_IM_MODULE=fcitx$" "$ENV_FILE" \
        && grep -q "^QT_IM_MODULE=fcitx$" "$ENV_FILE"
}

echo -e "${BLUE}[1/2] Environment variables${NC}"
if env_already_configured; then
    echo -e "  ${GREEN}✓ Already configured: $ENV_FILE${NC}"
elif [ -f "$ENV_FILE" ]; then
    echo -e "  ${YELLOW}Existing file: $ENV_FILE${NC}"
    echo "  Contents:"
    sed 's/^/    /' "$ENV_FILE"
    # `read` returns non-zero at end of input, which under this script's
    # `set -euo pipefail` would abort the run right here — before step 2 sets
    # up autostart — instead of falling through to the prompt's default. That
    # is the likely case for this script: it is the setup path a package
    # install points at, so it often runs unattended. Absorb the EOF, clear
    # REPLY first so no earlier value leaks in, and say that the default was
    # taken. Inlined rather than shared with the installers' scripts/_ask.sh:
    # this script is installed to /usr/bin on its own and cannot source it.
    REPLY=""
    if ! read -r -p "  Overwrite with fcitx5 settings? [Y/n] "; then
        echo
        echo "  No input received, taking the default."
    fi
    echo
    if [[ ! $REPLY =~ ^[Nn]$ ]]; then
        write_env_file
        echo -e "  ${GREEN}✓ Updated: $ENV_FILE${NC}"
    else
        echo -e "  ${YELLOW}Skipped. Make sure the fcitx5 input-method variables are set elsewhere.${NC}"
    fi
else
    write_env_file
    echo -e "  ${GREEN}✓ Created: $ENV_FILE${NC}"
fi
echo

# --- 2. Autostart (session-aware) -----------------------------------------
AUTOSTART_FILE="$HOME/.config/autostart/org.fcitx.Fcitx5.desktop"
mkdir -p "$(dirname "$AUTOSTART_FILE")"

echo -e "${BLUE}[2/2] Autostart (session: $SESSION, desktop: $DESKTOP)${NC}"

if is_kde_wayland; then
    # KDE Wayland: KWin auto-starts fcitx5 if Virtual Keyboard is set to
    # "Fcitx 5". An XDG autostart entry would launch a SECOND instance and
    # cause duplicate-IM conflicts.
    if [ -f "$AUTOSTART_FILE" ] && grep -q "^Hidden=true$" "$AUTOSTART_FILE"; then
        echo -e "  ${GREEN}✓ XDG autostart already disabled (KWin handles fcitx5 startup)${NC}"
    else
        cat > "$AUTOSTART_FILE" <<'EOF'
[Desktop Entry]
Hidden=true
EOF
        echo -e "  ${GREEN}✓ Disabled XDG autostart for KDE Wayland${NC}"
    fi
    echo -e "  ${YELLOW}Note: Make sure System Settings → Virtual Keyboard is set to 'Fcitx 5'.${NC}"
else
    SOURCE_DESKTOP=/usr/share/applications/org.fcitx.Fcitx5.desktop
    if [ ! -f "$SOURCE_DESKTOP" ]; then
        echo -e "  ${YELLOW}!  $SOURCE_DESKTOP not found — install fcitx5 first.${NC}"
    elif [ -f "$AUTOSTART_FILE" ] && cmp -s "$SOURCE_DESKTOP" "$AUTOSTART_FILE"; then
        echo -e "  ${GREEN}✓ Already configured: $AUTOSTART_FILE${NC}"
    else
        cp "$SOURCE_DESKTOP" "$AUTOSTART_FILE"
        echo -e "  ${GREEN}✓ Enabled XDG autostart: $AUTOSTART_FILE${NC}"
    fi
fi
echo

echo -e "${GREEN}Setup complete.${NC}"
echo -e "${YELLOW}Logout and login for environment variables to take effect.${NC}"
echo
echo "Next steps:"
echo "  1. Logout and login"
echo "  2. Run 'fcitx5-config-qt' (or open System Settings → Input Method)"
echo "  3. Add 'Schnelle Umlaute' to your input methods"
echo "  4. Toggle with Ctrl+Space and start typing"
